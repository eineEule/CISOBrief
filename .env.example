# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SITE_URL=http://localhost

# Database
POSTGRES_DB=cisobrief
POSTGRES_USER=cisobrief
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Email (SMTP). Test with:
#   docker compose exec web python manage.py check_email --to you@example.com
# ---------------------------------------------------------------------------
# A) Dev inbox (default): nothing leaves the machine; read mail at http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=cisobrief@localhost
#
# B) Gmail / Google Workspace (free). Needs 2-Step Verification + an App Password:
#    Google Account → Security → 2-Step Verification → App passwords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=<16-letter app password>
# DEFAULT_FROM_EMAIL=CISO Brief <you@gmail.com>
#
# C) Any other SMTP relay (Microsoft 365, Amazon SES, Brevo, Mailgun, your own server):
#    use the host/port/user/password it gives you. Port 587 → EMAIL_USE_TLS=1; port 465 → EMAIL_USE_SSL=1.

# ---------------------------------------------------------------------------
# AI (optional; every option below has a free path). Pick ONE block.
# With nothing set, AI is off: briefs still build, without the written
# summary / themes / actions. Test any choice with:
#   docker compose exec web python manage.py check_ai
# ---------------------------------------------------------------------------
# A) Free, private, runs on this machine (Ollama). Start it with:
#      docker compose --profile local-ai up -d
#    First start downloads the model (~5 GB). A GPU makes it much faster;
#    on CPU only, set AI_TIMEOUT=600 and consider AI_MODEL=qwen2.5:3b.
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=qwen2.5:7b
# AI_TIMEOUT=300
# AI_MAX_ITEMS=12
#
# B) Free tier, hosted: Google Gemini (key from https://aistudio.google.com, no card).
#    Note: check Google's terms on how free-tier prompts may be used before sending customer data.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash   # or any current Flash model listed in Google AI Studio
#
# C) Paid, hosted: OpenAI (key from https://platform.openai.com/api-keys)
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=120

# Threat intel pipeline
NVD_API_KEY=
LOOKBACK_HOURS=24
SEVERITY_FLOOR=50

# Early-warning sources (free). Blank = that source is skipped.
OTX_API_KEY=
ABUSECH_AUTH_KEY=
